{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nobg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "MAX_UPLOAD_BYTES": "10485760",
    "IP_REQUESTS_PER_MINUTE": "5",
    "IP_IMAGES_PER_DAY": "20",
    "IMAGES_PER_MONTH": "10000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTAS",
        "class_name": "QuotaCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaCounter"]
    }
  ]
}
