{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nobg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "MAX_UPLOAD_BYTES": "10485760"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
