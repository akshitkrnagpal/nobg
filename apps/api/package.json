{
  "name": "@nobg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nobg/contracts": "workspace:*",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "^24.0.0",
    "vitest": "^4.1.0",
    "wrangler": "4.132.0"
  }
}
