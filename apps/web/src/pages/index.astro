---
import { ArrowRightIcon, CheckIcon, CopyIcon, PlusIcon } from "@phosphor-icons/react/ssr";
import { Landing } from "@/components/landing";
import Layout from "@/components/layout.astro";
import { Wordmark } from "@/components/wordmark";

const command = `curl --fail-with-body \\\n  "https://api.nobg.akshit.io/api/v1/remove-background" \\\n  -F "image=@photo.jpg" \\\n  --output nobg.png`;
const faqs = [
  [
    "Is the demo free?",
    "Yes. Each IP gets 20 image attempts a day and 5 requests a minute. People sharing a network share the allowance. The demo also has a shared monthly limit; failed processing attempts count.",
  ],
  [
    "What can I upload?",
    "JPEG, PNG, or WebP files up to 10 MiB and 25 megapixels. The demo returns a transparent PNG. Animated images are returned as a still image.",
  ],
  [
    "Do you store my images?",
    "nobg does not save your uploads or results. Cloudflare Images processes the image when you choose Remove background. Download your result before leaving the page.",
  ],
  [
    "Can I run my own service?",
    "Yes. Deploy the API Worker in your own Cloudflare account and choose your own limits. Cloudflare charges for Images, Workers, and Durable Objects usage.",
  ],
  [
    "Can I use it in my app?",
    "The public API accepts multipart uploads without an API key. Use our endpoint or deploy your own. The docs include curl, JavaScript, and Python examples.",
  ],
];
---

<Layout
  title="nobg · Remove image backgrounds"
  description="Upload a photo and download a transparent PNG. Try the free nobg demo, use the API, or self-host it in your Cloudflare account."
>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <Landing pathname={Astro.url.pathname} params={Astro.params} client:load>
    <section id="how-it-works" class="section wrap">
      <h2>From photo to transparent PNG</h2>
      <div class="steps">
        <article>
          <h3>Choose your photo</h3>
          <p>Drop in a JPEG, PNG, or WebP. Preview it before sending anything.</p>
        </article>
        <article>
          <h3>Remove the background</h3>
          <p>Cloudflare Images separates the foreground from the background.</p>
        </article>
        <article>
          <h3>Download the result</h3>
          <p>Save the transparent PNG for your shop, design, or next project.</p>
        </article>
      </div>
    </section>
    <section class="api-section wrap">
      <div class="api-copy">
        <h2>Use it in your app</h2>
        <p>
          The API accepts a multipart upload and returns image bytes. Call it with any HTTP client.
          No API key is required.
        </p>
        <a class="text-link" href="/docs/examples/">
          See the integration examples <ArrowRightIcon size={18} aria-hidden="true" />
        </a>
      </div>
      <div class="code-window">
        <div class="code-top">
          <span>POST /api/v1/remove-background</span>
          <button id="copy-code" type="button" aria-label="Copy curl example">
            <span data-copy-label>Copy</span>
            <CopyIcon size={16} aria-hidden="true" data-copy-icon />
            <CheckIcon size={16} aria-hidden="true" data-copied-icon />
          </button>
        </div>
        <pre
          tabindex="0"
          aria-label="curl request example"
        ><code id="curl-code">{command}</code></pre>
        <p class="code-caption">The public API uses the same free allowance as the demo.</p>
        <span id="copy-status" class="sr-only" role="status" aria-live="polite"></span>
      </div>
    </section>
    <section class="faq wrap">
      <div>
        <h2>Common questions</h2>
        <a class="text-link" href="/docs/">
          More in the docs <ArrowRightIcon size={18} aria-hidden="true" />
        </a>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>
              {question}
              <PlusIcon className="faq-icon" size={20} aria-hidden="true" />
            </summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
    <section class="closing wrap">
      <div>
        <h2>Your own endpoint. Your own limits.</h2>
        <p>
          Deploy nobg in your Cloudflare account. The guide covers setup, costs, and your first
          request.
        </p>
      </div>
      <a class="button primary" href="/docs/quickstart/">
        Open the setup guide <ArrowRightIcon size={18} aria-hidden="true" />
      </a>
    </section>
  </Landing>
  <footer class="site-footer wrap">
    <a href="/" aria-label="nobg home">
      <Wordmark />
    </a>
    <p>Background removal, built on Cloudflare.</p>
    <nav aria-label="Footer navigation">
      <a href="/docs/">Docs</a>
      <a href="/docs/api/">API</a>
      <a href="/docs/costs/">Costs</a>
    </nav>
  </footer>
</Layout>
<script>
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const copy = target.closest<HTMLButtonElement>("#copy-code");
    if (!copy) return;
    const code = document.querySelector("#curl-code");
    const status = document.querySelector("#copy-status");
    if (!code?.textContent || !status) return;
    try {
      await navigator.clipboard.writeText(code.textContent);
      status.textContent = "curl example copied to clipboard.";
      copy.dataset.copied = "true";
      const label = copy.querySelector("[data-copy-label]");
      if (label) label.textContent = "Copied";
    } catch {
      const selection = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(code);
      selection?.removeAllRanges();
      selection?.addRange(range);
      status.textContent = "Code selected. Use your keyboard to copy it.";
    }
    setTimeout(() => {
      if (!copy.isConnected) return;
      delete copy.dataset.copied;
      const label = copy.querySelector("[data-copy-label]");
      if (label) label.textContent = "Copy";
    }, 2500);
  });
</script>
