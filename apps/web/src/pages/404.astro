---
import Layout from "@/components/layout.astro";
---

<Layout title="Page not found · nobg">
  <main class="wrap" style="padding-block:120px">
    <a class="wordmark" href="/">
      no<span>bg</span>
    </a>
    <h1 style="font-size:48px;margin-top:40px;letter-spacing:-2px">This page has disappeared.</h1>
    <p style="margin-block:24px;color:var(--muted)">
      The background isn't the only thing we couldn't find.
    </p>
    <a class="button primary" href="/">
      Back to nobg →
    </a>
    <a class="text-link" style="margin-left:24px" href="/docs/">
      Read the docs →
    </a>
  </main>
</Layout>
